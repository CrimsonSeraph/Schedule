{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "endOfLine": "crlf",
    "proseWrap": "never",
    "singleQuote": true,
    "semi": true,
    "arrowParens": "always",
    "trailingComma": "all",
    "bracketSpacing": true,
    "jsxSingleQuote": false,
    "overrides": [
        {
            "files": "*.yml",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
