{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure (Debug-x64)",
            "detail": "cmake --preset Debug-x64",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "Debug-x64"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
        },
        {
            "label": "cmake: build (Debug-x64)",
            "detail": "cmake --build --preset debug-x64",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "debug-x64"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["cmake: configure (Debug-x64)"],
            "dependsOrder": "sequence",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "cmake: run (Debug-x64)",
            "detail": "构建后启动 Schedule.exe",
            "type": "process",
            "command": "${workspaceFolder}/out/build/debug/Schedule.exe",
            "options": { "cwd": "${workspaceFolder}/out/build/debug" },
            "dependsOn": ["cmake: build (Debug-x64)"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}